rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function smallString(s,n) { return s is string && s.size() <= n; }
  function qty(n) { return n is int && n >= 0 && n <= 1000000; }
  function cents(n) { return n is int && n >= 0 && n <= 9007199254740991; }
  function cost(n) { return n is int && n >= 0 && n <= 1000000000000; }
  function price(n) { return n is number && n >= 0 && n <= 10000000000; }
  function maybeDate(d) { return d == null || d is timestamp; }
  function startToday() { let local = request.time + duration.value(330,'m'); return timestamp.date(local.year(),local.month(),local.day()) - duration.value(330,'m'); }
  function pAfter(id) { return getAfter(/databases/$(database)/documents/products/$(id)).data; }
  function bAfter(id) { return getAfter(/databases/$(database)/documents/batches/$(id)).data; }
  function opAfter(id) { return getAfter(/databases/$(database)/documents/stockOperations/$(id)).data; }
  function changeShape(o,i) { return o.changes.size() <= i || (o.changes[i] is map && o.changes[i].keys().hasOnly(['id','before','after','beforeCostMinor','afterCostMinor']) && o.changes[i].id == o.batchIds[i] && qty(o.changes[i].before) && qty(o.changes[i].after) && cost(o.changes[i].beforeCostMinor) && cost(o.changes[i].afterCostMinor)); }
  function changeIndex(o,id) { return o.batchIds.size()>0 && o.batchIds[0]==id ? 0 : o.batchIds.size()>1 && o.batchIds[1]==id ? 1 : o.batchIds.size()>2 && o.batchIds[2]==id ? 2 : o.batchIds.size()>3 && o.batchIds[3]==id ? 3 : o.batchIds.size()>4 && o.batchIds[4]==id ? 4 : o.batchIds.size()>5 && o.batchIds[5]==id ? 5 : o.batchIds.size()>6 && o.batchIds[6]==id ? 6 : 7; }
  function checkForced(c,d,o) { return bAfter(c.id).operationId==o.id && (c.after>0 ? d.activeBatchIds.hasAny([c.id]) : !d.activeBatchIds.hasAny([c.id])); }
  function forcedBatch(o,i,d) { return o.changes.size()<=i || checkForced(o.changes[i],d,o); }
  function opShape(d,id) { return d.keys().hasOnly(['id','productId','productCode','kind','previousQuantity','newQuantity','previousValueMinor','newValueMinor','previousVersion','nextVersion','batchIds','changes','referenceId','userId','timestamp']) && d.id == id && smallString(d.productId,200) && smallString(d.productCode,40) && d.kind in ['opening','migration','receipt','purchase-order','customer-return','adjustment','disposal','sale','supplier-return'] && d.userId == request.auth.uid && d.timestamp == request.time && qty(d.previousQuantity) && qty(d.newQuantity) && cents(d.previousValueMinor) && cents(d.newValueMinor) && d.previousVersion is int && d.nextVersion == d.previousVersion+1 && d.batchIds is list && d.changes is list && d.batchIds.size() > 0 && d.batchIds.size() <= 4 && d.batchIds.size() == d.changes.size() && d.batchIds.toSet().size() == d.batchIds.size() && smallString(d.referenceId,200); }
  function productShape(d) { return d.keys().hasAll(['productId','name','category','quantity','stockQuantity','purchasePrice','sellingPrice','expiryDate','onPromotion','promoPrice','createdAt']) && d.keys().hasOnly(['productId','name','category','quantity','stockQuantity','purchasePrice','sellingPrice','expiryDate','onPromotion','promoPrice','createdAt','barcode','imageUrl','lowStockThreshold','promotionStartDate','promotionEndDate','promotionHistory','batchManaged','activeBatchIds','stockVersion','stockValueMinor','sellableQuantity','lastOperationId','archived']) && smallString(d.productId,40) && smallString(d.name,150) && d.name.size()>0 && smallString(d.category,80) && qty(d.stockQuantity) && d.quantity==d.stockQuantity && price(d.purchasePrice) && price(d.sellingPrice) && price(d.promoPrice) && d.onPromotion is bool && (!d.onPromotion || d.promoPrice<d.sellingPrice) && maybeDate(d.expiryDate) && d.createdAt is timestamp && maybeDate(d.get('promotionStartDate',null)) && maybeDate(d.get('promotionEndDate',null)) && qty(d.get('lowStockThreshold',5)) && smallString(d.get('barcode',''),100) && smallString(d.get('imageUrl',''),2000) && d.get('archived',false) is bool; }
  function managedShape(d) { return d.batchManaged == true && d.activeBatchIds is list && d.activeBatchIds.size()<=40 && d.activeBatchIds.toSet().size()==d.activeBatchIds.size() && d.stockVersion is int && d.stockVersion>0 && cents(d.stockValueMinor) && qty(d.sellableQuantity) && d.sellableQuantity<=d.stockQuantity && smallString(d.lastOperationId,200); }
  function balanced(d,old,id) {
   let o=opAfter(d.lastOperationId);
   let c=o.changes;
   let quantityDelta=c[0].after-c[0].before+(c.size()>1?(c[1].after-c[1].before+(c.size()>2?(c[2].after-c[2].before+(c.size()>3?(c[3].after-c[3].before):0)):0)):0);
   let valueDelta=c[0].after*c[0].afterCostMinor-c[0].before*c[0].beforeCostMinor+(c.size()>1?(c[1].after*c[1].afterCostMinor-c[1].before*c[1].beforeCostMinor+(c.size()>2?(c[2].after*c[2].afterCostMinor-c[2].before*c[2].beforeCostMinor+(c.size()>3?(c[3].after*c[3].afterCostMinor-c[3].before*c[3].beforeCostMinor):0)):0)):0);
   return o.productId==id && o.previousQuantity==old.stockQuantity && o.newQuantity==d.stockQuantity && o.previousVersion==old.get('stockVersion',0) && o.nextVersion==d.stockVersion && o.newValueMinor==d.stockValueMinor
    && d.activeBatchIds.toSet().difference(old.get('activeBatchIds',[]).toSet()).difference(o.batchIds.toSet()).size()==0 && old.get('activeBatchIds',[]).toSet().difference(d.activeBatchIds.toSet()).difference(o.batchIds.toSet()).size()==0
    && forcedBatch(o,0,d) && forcedBatch(o,1,d) && forcedBatch(o,2,d) && forcedBatch(o,3,d)
    && (o.kind=='migration' ? (!old.get('batchManaged',false) && o.changes.size()==1 && o.previousQuantity==o.newQuantity && c[0].before==0 && c[0].after==old.stockQuantity && o.newValueMinor==old.stockQuantity*math.round(old.purchasePrice*100) && bAfter(o.batchIds[0]).expiryDate==old.expiryDate && bAfter(o.batchIds[0]).legacy==true && bAfter(o.batchIds[0]).supplierId==null && d.expiryDate==(old.stockQuantity>0?old.expiryDate:null))
     : (old.get('batchManaged',false) && o.previousValueMinor==old.stockValueMinor && d.stockQuantity==old.stockQuantity+quantityDelta && d.stockValueMinor==old.stockValueMinor+valueDelta));
  }
  match /users/{uid} {
   allow get: if signedIn() && request.auth.uid==uid;
   allow create: if signedIn() && request.auth.uid==uid && request.resource.data.keys().hasOnly(['uid','name','email','role','createdAt']) && request.resource.data.uid==uid && smallString(request.resource.data.name,200) && request.resource.data.name.size()>0 && request.resource.data.email==request.auth.token.email && request.resource.data.role=='staff' && request.resource.data.createdAt==request.time;
   allow update: if signedIn() && request.auth.uid==uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']) && smallString(request.resource.data.name,200) && request.resource.data.name.size()>0;
   allow list,delete: if false;
  }
  match /products/{id} {
   allow read: if signedIn();
   allow create: if signedIn() && productShape(request.resource.data) && managedShape(request.resource.data) && request.resource.data.createdAt==request.time && request.resource.data.productId==id && opAfter(request.resource.data.lastOperationId).kind=='opening' && opAfter(request.resource.data.lastOperationId).productId==id && opAfter(request.resource.data.lastOperationId).previousQuantity==0 && opAfter(request.resource.data.lastOperationId).newQuantity==request.resource.data.stockQuantity && opAfter(request.resource.data.lastOperationId).newValueMinor==request.resource.data.stockValueMinor && opAfter(request.resource.data.lastOperationId).changes.size()==1 && forcedBatch(opAfter(request.resource.data.lastOperationId),0,request.resource.data) && request.resource.data.stockValueMinor==request.resource.data.stockQuantity*math.round(request.resource.data.purchasePrice*100);
   allow update: if signedIn() && request.resource.data.createdAt==resource.data.createdAt && request.resource.data.productId==resource.data.productId && (
    (productShape(request.resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','category','purchasePrice','sellingPrice','expiryDate','onPromotion','promoPrice','promotionStartDate','promotionEndDate','promotionHistory','barcode','imageUrl','lowStockThreshold','archived']) && (!resource.data.get('batchManaged',false) || (request.resource.data.purchasePrice==resource.data.purchasePrice && request.resource.data.expiryDate==resource.data.expiryDate)) && (!request.resource.data.get('archived',false) || resource.data.stockQuantity==0)) ||
    (managedShape(request.resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['batchManaged','activeBatchIds','stockVersion','stockValueMinor','sellableQuantity','lastOperationId','stockQuantity','quantity','expiryDate','purchasePrice']) && !exists(/databases/$(database)/documents/stockOperations/$(request.resource.data.lastOperationId)) && balanced(request.resource.data,resource.data,id)));
   allow delete: if signedIn() && !resource.data.get('batchManaged',false) && resource.data.stockQuantity==0;
  }
  match /stockOperations/{id} {
   allow read: if signedIn();
   allow create: if signedIn() && opShape(request.resource.data,id) && pAfter(request.resource.data.productId).lastOperationId==id && pAfter(request.resource.data.productId).stockVersion==request.resource.data.nextVersion;
   allow update,delete: if false;
  }
  function batchShape(d,id) { return d.keys().hasAll(['id','productId','productCode','productName','batchNumber','supplierId','supplierName','quantityReceived','quantity','unitCostMinor','expiryDate','receivedAt','updatedAt','purchaseOrderId','notes','legacy','version','operationId']) && d.keys().hasOnly(['id','productId','productCode','productName','batchNumber','supplierId','supplierName','quantityReceived','quantity','unitCostMinor','expiryDate','receivedAt','updatedAt','purchaseOrderId','notes','legacy','version','operationId','migrationOriginalCreatedAt']) && d.id==id && smallString(d.productId,200) && smallString(d.productCode,40) && smallString(d.productName,150) && smallString(d.batchNumber,80) && d.batchNumber.size()>0 && (d.supplierId==null || smallString(d.supplierId,200)) && smallString(d.supplierName,150) && qty(d.quantityReceived) && qty(d.quantity) && cost(d.unitCostMinor) && maybeDate(d.expiryDate) && d.receivedAt is timestamp && d.updatedAt==request.time && (d.purchaseOrderId==null || smallString(d.purchaseOrderId,200)) && smallString(d.notes,1000) && d.legacy is bool && d.version is int && d.version>0 && smallString(d.operationId,200); }
  function batchOperation(d,id,oldQuantity,oldCost) { let o=opAfter(d.operationId); let c=o.changes[changeIndex(o,id)]; return changeShape(o,changeIndex(o,id)) && !exists(/databases/$(database)/documents/stockOperations/$(d.operationId)) && o.productId==d.productId && o.batchIds.hasAny([id]) && c.id==id && c.before==oldQuantity && c.after==d.quantity && c.beforeCostMinor==oldCost && c.afterCostMinor==d.unitCostMinor; }
  match /batches/{id} {
   allow read: if signedIn();
   allow create: if signedIn() && batchShape(request.resource.data,id) && request.resource.data.version==1 && request.resource.data.receivedAt==request.time && request.resource.data.quantity==request.resource.data.quantityReceived && batchOperation(request.resource.data,id,0,request.resource.data.unitCostMinor) && opAfter(request.resource.data.operationId).kind in ['opening','migration','receipt','purchase-order','customer-return'];
   allow update: if signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity','expiryDate','batchNumber','notes','supplierId','supplierName','version','operationId','updatedAt']) && qty(request.resource.data.quantity) && maybeDate(request.resource.data.expiryDate) && smallString(request.resource.data.batchNumber,80) && smallString(request.resource.data.notes,1000) && smallString(request.resource.data.supplierName,150) && (request.resource.data.supplierId==null || smallString(request.resource.data.supplierId,200)) && request.resource.data.updatedAt==request.time && request.resource.data.version==resource.data.version+1 && request.resource.data.productId==resource.data.productId && request.resource.data.productCode==resource.data.productCode && request.resource.data.productName==resource.data.productName && request.resource.data.quantityReceived==resource.data.quantityReceived && request.resource.data.unitCostMinor==resource.data.unitCostMinor && request.resource.data.receivedAt==resource.data.receivedAt && request.resource.data.purchaseOrderId==resource.data.purchaseOrderId && request.resource.data.legacy==resource.data.legacy && batchOperation(request.resource.data,id,resource.data.quantity,resource.data.unitCostMinor) && (request.resource.data.quantity>=resource.data.quantity || opAfter(request.resource.data.operationId).kind in ['sale','supplier-return','disposal','adjustment']);
   allow delete: if false;
  }
  match /counters/products {
   allow get: if signedIn();
   allow create: if signedIn() && request.resource.data.keys().hasOnly(['lastId']) && request.resource.data.lastId is int && request.resource.data.lastId>0;
   allow update: if signedIn() && request.resource.data.keys().hasOnly(['lastId']) && request.resource.data.lastId is int && request.resource.data.lastId>resource.data.lastId;
   allow list,delete: if false;
  }
  function allocation(d,o,i) { return d.batchAllocations.size()<=i || (d.batchAllocations[i].batchId==o.batchIds[i] && d.batchAllocations[i].quantity==o.changes[i].before-o.changes[i].after && d.batchAllocations[i].quantity>0 && d.batchAllocations[i].unitCostMinor==o.changes[i].beforeCostMinor && (get(/databases/$(database)/documents/batches/$(o.batchIds[i])).data.expiryDate==null || get(/databases/$(database)/documents/batches/$(o.batchIds[i])).data.expiryDate>=startToday())); }
  function saleShape(d,id) { let o=opAfter(d.operationId); return d.saleId==id && d.userId==request.auth.uid && d.timestamp==request.time && qty(d.quantity) && d.quantity>0 && price(d.unitPrice) && math.round(d.totalAmount*100)==math.round(d.unitPrice*100)*d.quantity && d.operationId=='sale-'+id && o.kind=='sale' && o.referenceId==id && d.quantity==o.previousQuantity-o.newQuantity && d.costMinor==o.previousValueMinor-o.newValueMinor && d.productDocId==o.productId && d.batchIds==o.batchIds && d.batchAllocations is list && d.batchAllocations.size()==d.batchIds.size() && allocation(d,o,0) && allocation(d,o,1) && allocation(d,o,2) && allocation(d,o,3); }
  match /sales/{id} {
   allow read: if signedIn();
   allow create: if signedIn() && saleShape(request.resource.data,id);
   allow update,delete: if false;
  }
  match /StockHistory/{id} {
   allow read: if signedIn();
   allow create: if signedIn() && request.resource.data.id==id && request.resource.data.timestamp==request.time && qty(request.resource.data.previousQuantity) && qty(request.resource.data.newQuantity) && request.resource.data.changeType in ['Restock','Adjustment','Damage','Sale'] && smallString(request.resource.data.reason,1000) && (request.resource.data.get('operationId','')!='' ? (opAfter(request.resource.data.operationId).productCode==request.resource.data.productId && opAfter(request.resource.data.operationId).previousQuantity==request.resource.data.previousQuantity && opAfter(request.resource.data.operationId).newQuantity==request.resource.data.newQuantity) : (request.resource.data.previousQuantity==request.resource.data.newQuantity && (request.resource.data.get('eventType','')=='promotion' || request.resource.data.reason=='Product deleted')));
   allow update,delete: if false;
  }
  function supplierShape(d) { return d.keys().hasOnly(['name','contact','email','phone','address','paymentTerms','notes','active','version','createdAt','updatedAt']) && smallString(d.name,150) && d.name.size()>0 && smallString(d.contact,150) && smallString(d.email,200) && smallString(d.phone,50) && smallString(d.address,500) && smallString(d.paymentTerms,200) && smallString(d.notes,1000) && d.active is bool && d.version is int && d.updatedAt==request.time && d.createdAt is timestamp; }
  match /suppliers/{id} {
   allow read: if signedIn();
   allow create: if signedIn() && supplierShape(request.resource.data) && request.resource.data.version==1 && request.resource.data.createdAt==request.time;
   allow update: if signedIn() && supplierShape(request.resource.data) && request.resource.data.createdAt==resource.data.createdAt && request.resource.data.version==resource.data.version+1;
   allow delete: if false;
  }
  function validLine(l) { return l.keys().hasOnly(['productId','productCode','productName','quantity','received','unitCostMinor']) && l.productId is string && l.productCode is string && l.productName is string && qty(l.quantity) && l.quantity>0 && qty(l.received) && l.received<=l.quantity && cost(l.unitCostMinor); }
  function orderLine(d,i) { return d.lines.size()<=i || validLine(d.lines[i]); }
  function outstanding(d,i) { return d.lines.size()<=i ? 0 : d.lines[i].quantity-d.lines[i].received; }
  function orderShape(d) { return d.keys().hasOnly(['number','supplierId','supplierName','status','lines','expectedDate','notes','totalMinor','receivedMinor','version','createdAt','updatedAt','createdBy','lastReceiptId']) && smallString(d.number,50) && smallString(d.supplierId,200) && smallString(d.supplierName,150) && d.status in ['draft','ordered','partial','received','cancelled'] && d.lines is list && d.lines.size()>0 && d.lines.size()<=4 && maybeDate(d.expectedDate) && smallString(d.notes,1000) && cents(d.totalMinor) && cents(d.receivedMinor) && d.version is int && d.createdAt is timestamp && d.updatedAt==request.time && d.totalMinor==(d.lines[0].quantity*d.lines[0].unitCostMinor+(d.lines.size()>1?(d.lines[1].quantity*d.lines[1].unitCostMinor+(d.lines.size()>2?(d.lines[2].quantity*d.lines[2].unitCostMinor+(d.lines.size()>3?(d.lines[3].quantity*d.lines[3].unitCostMinor):0)):0)):0)) && d.receivedMinor==(d.lines[0].received*d.lines[0].unitCostMinor+(d.lines.size()>1?(d.lines[1].received*d.lines[1].unitCostMinor+(d.lines.size()>2?(d.lines[2].received*d.lines[2].unitCostMinor+(d.lines.size()>3?(d.lines[3].received*d.lines[3].unitCostMinor):0)):0)):0)) && orderLine(d,0) && orderLine(d,1) && orderLine(d,2) && orderLine(d,3); }
  function receiptBatch(receipt,i) { return bAfter(receipt.batchIds[i]); }
  function receiptUnits(b,l) { return b.productId==l.productId ? (b.unitCostMinor==l.unitCostMinor ? b.quantityReceived : -100000000) : 0; }
  function receivedLine(d,old,bs,i) { return d.lines.size()<=i || (d.lines[i].diff(old.lines[i]).affectedKeys().hasOnly(['received']) && qty(d.lines[i].received) && d.lines[i].received<=d.lines[i].quantity && d.lines[i].received-old.lines[i].received==receiptUnits(bs[0],d.lines[i])+receiptUnits(bs[1],d.lines[i])+receiptUnits(bs[2],d.lines[i])+receiptUnits(bs[3],d.lines[i])); }
  function receivedOrder(d,old,id) {
   let r=getAfter(/databases/$(database)/documents/purchaseReceipts/$(d.lastReceiptId)).data;
   let empty={'productId':'','quantityReceived':0,'unitCostMinor':0};
   let bs=[bAfter(r.batchIds[0]),r.batchIds.size()>1?bAfter(r.batchIds[1]):empty,r.batchIds.size()>2?bAfter(r.batchIds[2]):empty,r.batchIds.size()>3?bAfter(r.batchIds[3]):empty];
   let remaining=outstanding(d,0)+outstanding(d,1)+outstanding(d,2)+outstanding(d,3);
   return old.status in ['ordered','partial'] && d.status in ['partial','received'] && d.diff(old).affectedKeys().hasOnly(['lines','receivedMinor','status','version','updatedAt','lastReceiptId']) && d.updatedAt==request.time && d.lines.size()==old.lines.size() && d.receivedMinor==old.receivedMinor+r.receivedMinor && r.purchaseOrderId==id && !exists(/databases/$(database)/documents/purchaseReceipts/$(d.lastReceiptId)) && (d.status=='received'?remaining==0:remaining>0) && receivedLine(d,old,bs,0) && receivedLine(d,old,bs,1) && receivedLine(d,old,bs,2) && receivedLine(d,old,bs,3);
  }
  match /purchaseOrders/{id} {
   allow read: if signedIn();
   allow create: if signedIn() && orderShape(request.resource.data) && request.resource.data.status=='draft' && request.resource.data.receivedMinor==0 && request.resource.data.version==1 && request.resource.data.createdAt==request.time && request.resource.data.createdBy==request.auth.uid && get(/databases/$(database)/documents/suppliers/$(request.resource.data.supplierId)).data.active==true;
   allow update: if signedIn() && request.resource.data.createdAt==resource.data.createdAt && request.resource.data.createdBy==resource.data.createdBy && request.resource.data.version==resource.data.version+1 && (
    (resource.data.status=='draft' && request.resource.data.status=='draft' && orderShape(request.resource.data) && request.resource.data.receivedMinor==0) ||
    (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','version','updatedAt']) && orderShape(request.resource.data) && ((resource.data.status=='draft' && request.resource.data.status=='ordered') || (resource.data.status in ['draft','ordered','partial'] && request.resource.data.status=='cancelled'))) || receivedOrder(request.resource.data,resource.data,id));
   allow delete: if false;
  }
  function receiptCheck(d,i) { return d.batchIds.size()<=i || (receiptBatch(d,i).purchaseOrderId==d.purchaseOrderId && receiptBatch(d,i).supplierId==d.supplierId && receiptBatch(d,i).receivedAt==request.time && opAfter(receiptBatch(d,i).operationId).kind=='purchase-order'); }
  function receiptCost(d,i) { return d.batchIds.size()<=i ? 0 : receiptBatch(d,i).quantityReceived*receiptBatch(d,i).unitCostMinor; }
  match /purchaseReceipts/{id} {
   allow read: if signedIn();
   allow create: if signedIn() && request.resource.data.keys().hasOnly(['id','purchaseOrderId','batchIds','supplierId','receivedMinor','createdAt','userId']) && request.resource.data.id==id && request.resource.data.userId==request.auth.uid && request.resource.data.createdAt==request.time && request.resource.data.batchIds is list && request.resource.data.batchIds.size()>0 && request.resource.data.batchIds.size()<=4 && request.resource.data.batchIds.toSet().size()==request.resource.data.batchIds.size() && getAfter(/databases/$(database)/documents/purchaseOrders/$(request.resource.data.purchaseOrderId)).data.lastReceiptId==id && request.resource.data.receivedMinor==receiptCost(request.resource.data,0)+receiptCost(request.resource.data,1)+receiptCost(request.resource.data,2)+receiptCost(request.resource.data,3) && receiptCheck(request.resource.data,0) && receiptCheck(request.resource.data,1) && receiptCheck(request.resource.data,2) && receiptCheck(request.resource.data,3);
   allow update,delete: if false;
  }
  match /supplierReturns/{id} {
   allow read: if signedIn();
   allow create: if signedIn() && request.resource.data.keys().hasOnly(['id','productId','productCode','productName','batchId','batchNumber','supplierId','supplierName','quantity','reason','expectedCreditMinor','creditMinor','status','reference','decisionNotes','version','createdAt','settledAt','operationId']) && request.resource.data.id==id && qty(request.resource.data.quantity) && request.resource.data.quantity>0 && smallString(request.resource.data.reason,500) && request.resource.data.reason.size()>0 && request.resource.data.supplierId!=null && request.resource.data.supplierId==bAfter(request.resource.data.batchId).supplierId && request.resource.data.expectedCreditMinor==request.resource.data.quantity*bAfter(request.resource.data.batchId).unitCostMinor && request.resource.data.creditMinor==0 && request.resource.data.status=='pending' && request.resource.data.version==1 && request.resource.data.createdAt==request.time && request.resource.data.settledAt==null && opAfter(request.resource.data.operationId).kind=='supplier-return' && opAfter(request.resource.data.operationId).referenceId==id && opAfter(request.resource.data.operationId).batchIds==[request.resource.data.batchId] && request.resource.data.quantity==opAfter(request.resource.data.operationId).previousQuantity-opAfter(request.resource.data.operationId).newQuantity;
   allow update: if signedIn() && resource.data.status=='pending' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','creditMinor','reference','decisionNotes','version','settledAt','settledBy']) && request.resource.data.status in ['credited','rejected'] && cost(request.resource.data.creditMinor) && (request.resource.data.status=='credited'||request.resource.data.creditMinor==0) && smallString(request.resource.data.reference,200) && request.resource.data.reference.size()>0 && smallString(request.resource.data.decisionNotes,1000) && request.resource.data.version==resource.data.version+1 && request.resource.data.settledAt==request.time && request.resource.data.settledBy==request.auth.uid;
   allow delete: if false;
  }
  function condition(batch) { return batch.expiryDate==null ? 'none' : batch.expiryDate<startToday() ? 'expired' : batch.expiryDate<startToday()+duration.value(4,'d') ? 'critical' : batch.expiryDate<startToday()+duration.value(8,'d') ? 'warning' : batch.expiryDate<startToday()+duration.value(15,'d') ? 'near' : batch.expiryDate<startToday()+duration.value(31,'d') ? 'approaching' : 'none'; }
  function linked(event,batchId,i) { return event.links.size()<=i || (event.links[i].collection in ['sales','StockHistory','supplierReturns'] && smallString(event.links[i].id,200) && (getAfter(/databases/$(database)/documents/$(event.links[i].collection)/$(event.links[i].id)).data.get('batchId','')==batchId || getAfter(/databases/$(database)/documents/$(event.links[i].collection)/$(event.links[i].id)).data.get('batchIds',[]).hasAny([batchId]))); }
  function alertShape(d,id) { let batch=bAfter(d.batchId); let event=d.history[d.history.size()-1]; return d.keys().hasOnly(['batchId','productId','condition','status','responsibleId','responsibleName','history','version','createdAt','updatedAt','resolvedAt']) && d.productId==batch.productId && d.condition==condition(batch) && d.condition!='none' && id==d.batchId+'_'+string(batch.expiryDate.toMillis())+'_'+d.condition && d.status in ['reviewing','resolved'] && d.responsibleId==request.auth.uid && smallString(d.responsibleName,200) && d.history is list && d.history.size()>0 && d.history.size()<=100 && d.version is int && d.updatedAt==request.time && (d.status=='resolved'?d.resolvedAt==request.time:d.resolvedAt==null) && event.id==id+'_'+string(d.version) && event.status==d.status && event.userId==request.auth.uid && event.userName==d.responsibleName && event.at is timestamp && event.at<=request.time+duration.value(5,'m') && event.action in ['review','promotion','supplier-return','disposal','explanation'] && smallString(event.notes,1000) && event.notes.size()>0 && event.links is list && event.links.size()<=4 && linked(event,d.batchId,0) && linked(event,d.batchId,1) && linked(event,d.batchId,2) && linked(event,d.batchId,3); }
  match /alertResolutions/{id} {
   allow read: if signedIn();
   allow create: if signedIn() && alertShape(request.resource.data,id) && request.resource.data.version==1 && request.resource.data.history.size()==1 && request.resource.data.createdAt==request.time;
   allow update: if signedIn() && alertShape(request.resource.data,id) && request.resource.data.createdAt==resource.data.createdAt && request.resource.data.version==resource.data.version+1 && request.resource.data.history.size()==resource.data.history.size()+1 && request.resource.data.history.removeAll([request.resource.data.history[request.resource.data.history.size()-1]])==resource.data.history;
   allow delete: if false;
  }
  match /inventorySnapshots/{id} { allow read: if signedIn(); allow write: if false; }
  match /notificationPreferences/{uid} { allow read,write: if false; }
 }
}
